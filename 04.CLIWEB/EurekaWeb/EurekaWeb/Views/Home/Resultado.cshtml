@model EurekaWeb.Models.ResultadoVm
@{
    Layout = null;
    bool esExitoso = Model.EsExitoso;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Resultado - EurekaBank</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
            /* Estilos específicos para el modal que ya están en site.css, pero reafirmamos */
            .confetti {
                position: fixed;
                width: 10px;
                height: 10px;
                background: var(--secondary);
                animation: confettiFall 3s linear forwards;
                pointer-events: none;
                z-index: 2000;
            }

            @@keyframes confettiFall {
                0% {
                    transform: translateY(-100px) rotate(0deg);
                    opacity: 1;
                }

                100% {
                    transform: translateY(100vh) rotate(720deg);
                    opacity: 0;
                }
            }
    </style>
</head>
<body>
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal-content">
            <div class="result-icon">
                @if (esExitoso)
                {
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10" fill="#2ecc71" />
                        <path d="M8 12.5l2.5 2.5 5.5-5.5" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10" fill="#e74c3c" />
                        <path d="M8 8l8 8M16 8l-8 8" stroke="white" stroke-width="2.5" stroke-linecap="round" />
                    </svg>
                }
            </div>
            <h2 style="color: @(esExitoso ? "#2ecc71" : "#e74c3c");">
                @(esExitoso ? "¡Operación Exitosa!" : "Error en la Operación")
            </h2>
            <div class="modal-message">
                @Model.Mensaje
            </div>
            @if (esExitoso && Model.Saldo.HasValue && !string.IsNullOrEmpty(Model.Cuenta))
            {
                <div class="saldo-info">
                    <strong>Nuevo saldo disponible</strong><br />
                    Cuenta <strong>@Model.Cuenta</strong>: $ @Model.Saldo.Value.ToString("N2")
                </div>
            }
            <a asp-controller="Home" asp-action="Menu" class="btn-back-menu">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="white" />
                </svg>
                Volver al menú
            </a>
        </div>
    </div>

    @if (esExitoso)
    {
        <script>
                function crearConfeti() {
                    for (let i = 0; i < 80; i++) {
                        let conf = document.createElement('div');
                        conf.className = 'confetti';
                        conf.style.left = Math.random() * 100 + '%';
                        conf.style.backgroundColor = ['#e67e22', '#f39c12', '#0a3d62', '#2ecc71', '#e74c3c'][Math.floor(Math.random() * 5)];
                        conf.style.width = (Math.random() * 8 + 4) + 'px';
                        conf.style.height = conf.style.width;
                        conf.style.animationDelay = Math.random() * 2 + 's';
                        conf.style.animationDuration = Math.random() * 2 + 2 + 's';
                        document.body.appendChild(conf);
                        setTimeout(() => conf.remove(), 4000);
                    }
                }
                window.onload = crearConfeti;
        </script>
    }
</body>
</html>