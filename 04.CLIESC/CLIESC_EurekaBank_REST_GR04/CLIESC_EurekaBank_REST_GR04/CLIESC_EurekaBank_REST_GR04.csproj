<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- o net6.0-windows si no tienes .NET 8 -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="ec.edu.monster.assets\img\logo-ldu.png" />
    <None Remove="ec.edu.monster.assets\img\monster.jpg" />
    <None Remove="ec.edu.monster.assets\img\sullivan.jpg" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="ec.edu.monster.assets\img\logo-ldu.png" />
    <Resource Include="ec.edu.monster.assets\img\monster.jpg" />
    <Resource Include="ec.edu.monster.assets\img\sullivan.jpg" />
  </ItemGroup>
</Project>
