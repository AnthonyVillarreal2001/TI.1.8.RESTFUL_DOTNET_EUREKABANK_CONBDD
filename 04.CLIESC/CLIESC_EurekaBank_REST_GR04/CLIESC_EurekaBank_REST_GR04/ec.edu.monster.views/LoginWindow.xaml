<Window x:Class="ec.edu.monster.views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EurekaBank | Ingreso" Width="500" Height="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        AllowsTransparency="True" WindowStyle="None">
    <Window.Background>
        <ImageBrush ImageSource="/ec.edu.monster.assets/img/sullivan.jpg" Stretch="UniformToFill"/>
    </Window.Background>
    <Grid>
        <Rectangle Fill="#80000000" />
        <Border Width="380" Background="White" CornerRadius="30" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{StaticResource DropShadowEffect}">
            <StackPanel>
                <Border CornerRadius="15" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Image Source="/ec.edu.monster.assets;component/img/logo-ldu.png" Height="60"/>
                </Border>
                <TextBlock Text="Ingreso al sistema" FontSize="22" FontWeight="Bold" Foreground="#0a3d62" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                <TextBox x:Name="TxtUser" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,15" Tag="Usuario" Text="MONSTER"/>

                <!-- PasswordBox con estilo propio -->
                <PasswordBox x:Name="TxtPass" Style="{StaticResource RoundedPasswordBox}" Margin="0,0,0,25"/>

                <Button x:Name="BtnLogin" Content="INGRESAR" Style="{StaticResource OrangeButton}"/>
                <TextBlock x:Name="ErrorMsg" Foreground="#e74c3c" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>