<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_02.CLIMOV.Vista.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <Grid RowDefinitions="Auto,*" BackgroundColor="#000000">

        <!-- Header con Logo y Título -->
        <Grid Grid.Row="0" BackgroundColor="#D90a3d62" Padding="20,15">
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <Image Source="logo_ldu.png"
                       HeightRequest="45"
                       WidthRequest="45"
                       Aspect="AspectFit"/>
                <Label Text="EurekaBank"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Fondo con imagen y overlay -->
        <Grid Grid.Row="1">
            <Image Source="sullivan.jpg"
                   Aspect="AspectFill"
                   Opacity="0.4"/>

            <BoxView Color="#000000" Opacity="0.6"/>

            <!-- ScrollView con el contenido del login -->
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="20" HorizontalOptions="Center">

                    <!-- Tarjeta de Login Blanca -->
                    <Frame CornerRadius="20"
                           HasShadow="True"
                           Padding="40,30"
                           BackgroundColor="White"
                           HorizontalOptions="Center"
                           WidthRequest="340">

                        <VerticalStackLayout Spacing="20">

                            <!-- Icono de usuario circular -->
                            <Frame CornerRadius="40"
                                   HasShadow="False"
                                   Padding="0"
                                   BackgroundColor="White"
                                   BorderColor="#0a3d62"
                                   HorizontalOptions="Center"
                                   WidthRequest="80"
                                   HeightRequest="80">
                                <Label Text="👤"
                                       FontSize="40"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="#0a3d62"/>
                            </Frame>

                            <!-- Título -->
                            <Label Text="Ingreso al sistema"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="#0a3d62"
                                   Margin="0,5,0,10"/>

                            <!-- Campo Usuario -->
                            <Frame CornerRadius="25"
                                   HasShadow="False"
                                   Padding="0"
                                   BackgroundColor="White"
                                   BorderColor="#CCCCCC">
                                <Grid ColumnDefinitions="Auto,*" Padding="15,12">
                                    <Label Grid.Column="0"
                                           Text="👤"
                                           FontSize="16"
                                           TextColor="#999999"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0"/>
                                    <Entry Grid.Column="1"
                                           x:Name="EntryUsuario"
                                           Placeholder="Usuario"
                                           PlaceholderColor="#999999"
                                           TextColor="#000000"
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Frame>

                            <!-- Campo Contraseña -->
                            <Frame CornerRadius="25"
                                   HasShadow="False"
                                   Padding="0"
                                   BackgroundColor="White"
                                   BorderColor="#CCCCCC">
                                <Grid ColumnDefinitions="Auto,*" Padding="15,12">
                                    <Label Grid.Column="0"
                                           Text="🔒"
                                           FontSize="16"
                                           TextColor="#999999"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0"/>
                                    <Entry Grid.Column="1"
                                           x:Name="EntryPassword"
                                           Placeholder="Contraseña"
                                           PlaceholderColor="#999999"
                                           TextColor="#000000"
                                           FontSize="14"
                                           IsPassword="True"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Frame>

                            <!-- Botón INGRESAR naranja -->
                            <Button x:Name="BtnLogin"
                                    Text="INGRESAR"
                                    Clicked="OnLoginClicked"
                                    HeightRequest="45"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="White"
                                    BackgroundColor="#e67e22"
                                    CornerRadius="25"
                                    Margin="0,10,0,0"/>

                            <!-- Loading Indicator -->
                            <ActivityIndicator x:Name="LoadingIndicator"
                                             IsRunning="False"
                                             IsVisible="False"
                                             Color="#e67e22"
                                             HeightRequest="40"/>

                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
